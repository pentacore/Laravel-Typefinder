{
    "name": "@pentacore/vite-plugin-laravel-typefinder",
    "version": "8.6.0",
    "description": "Vite plugin for Laravel Typefinder — auto-generate TypeScript types from Models, Enums, Casts, and Requests.",
    "keywords": [
        "vite",
        "vite-plugin",
        "laravel",
        "typescript",
        "types"
    ],
    "license": "MIT",
    "homepage": "https://github.com/pentacore/laravel-typefinder",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pentacore/laravel-typefinder.git"
    },
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "peerDependencies": {
        "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.19.1",
        "@vitest/coverage-v8": "^5.1.1",
        "eslint": "^10.15.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.74.0",
        "vite": "^8.3.3",
        "vite-plugin-dts": "^5.1.2",
        "vitest": "^5.0.3"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "author": "Pentacore <contact@pentacore.se>",
    "bugs": {
        "url": "https://github.com/pentacore/Laravel-Typefinder/issues"
    }
}
