{
    "name": "laravel-typefinder-workspace",
    "private": true,
    "workspaces": [
        "packages/vite-plugin-laravel-typefinder"
    ],
    "scripts": {
        "build": "npm -w packages/vite-plugin-laravel-typefinder run build",
        "lint": "npm -w packages/vite-plugin-laravel-typefinder run lint",
        "lint:output": "eslint -c workbench/eslint.typefinder.config.mjs --max-warnings 0 workbench/resources/js"
    },
    "devDependencies": {
        "@semantic-release/changelog": "7.0.0",
        "@semantic-release/commit-analyzer": "13.0.1",
        "@semantic-release/exec": "7.1.0",
        "@semantic-release/git": "11.0.1",
        "@semantic-release/github": "12.0.11",
        "@semantic-release/npm": "13.2.0",
        "@semantic-release/release-notes-generator": "14.1.1",
        "conventional-changelog-conventionalcommits": "9.3.1",
        "semantic-release": "26.0.1"
    }
}
